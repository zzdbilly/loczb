{
  "name": "loczb-comments",
  "version": "1.0.0",
  "type": "module",
  "description": "Comment system for loczb blog using Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create loczb-comments",
    "db:init:local": "wrangler d1 execute loczb-comments --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute loczb-comments --remote --file=schema.sql",
    "db:query": "wrangler d1 execute loczb-comments --command"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
